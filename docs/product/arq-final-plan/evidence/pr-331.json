      "patch": "@@ -1,8 +1,10 @@\n # Deploys the public website (apps/marketing) to GitHub Pages.\n #\n-# The site builds with SITE_BASE_PATH=/Arq because a project Pages site is\n-# served under https://<owner>.github.io/Arq/ - every internal URL is\n-# prefixed at build time (see apps/marketing/src/build.ts's applyBasePath).\n+# The site derives SITE_BASE_PATH from the live GitHub repository name because\n+# project Pages sites are served under https://<owner>.github.io/<repo>/.\n+# This keeps the deployment valid across a repository rename without changing\n+# the ARQ product identity. Internal URLs are prefixed at build time (see\n+# apps/marketing/src/build.ts's applyBasePath).\n # SITE_ORIGIN enables sitemap.xml, the robots Sitemap line and absolute\n # Open Graph URLs.\n #\n@@ -68,8 +70,8 @@ jobs:\n           pnpm arq:language:routes:verify\n       - run: pnpm --filter @arq/marketing build\n         env:\n-          SITE_BASE_PATH: /Arq\n-          SITE_ORIGIN: https://ruddvz.github.io\n+          SITE_BASE_PATH: /${{ github.event.repository.name }}\n+          SITE_ORIGIN: https://${{ github.repository_owner }}.github.io\n           SITE_REVISION: ${{ github.sha }}\n       # Audits the rendered HTML, not the TypeScript source, then writes\n       # arq-language-site-proof.json (this exact SHA plus a sha256 per route)"
    },
