{
  "schemaVersion": 2,
  "purpose": "An explicit review inventory for every public marketing content source. It reconciles source modules, the public route map, the typed page registry and generated static output so a new, renamed or unclassified page cannot silently escape claim governance.",
  "contentRoot": "apps/marketing/src/content",
  "routeMapPath": "docs/pages/ROUTE-MAP.csv",
  "routeRegistryPath": "apps/marketing/src/routes.ts",
  "includedExtensions": [".ts", ".tsx", ".md", ".mdx"],
  "classificationRules": {
    "claim-bearing": "Contains a current, planned, capability, pricing, privacy, file, AI, support, legal or product-scope assertion that needs a claim binding.",
    "non-claim": "Contains no governed product assertion, but remains subject to editorial review and must state why it has no binding."
  },
  "entries": [
    {
      "id": "public-home",
      "pageId": "PUB-001",
      "route": "/",
      "sourcePath": "apps/marketing/src/content/home.ts",
      "classification": "claim-bearing",
      "claimBindingIds": [
        "pub-home-native-file",
        "pub-home-local-persistence",
        "pub-home-semantic-tools"
      ],
      "owner": "marketing and product",
      "reviewTriggers": ["source-change", "claim-state-change", "file-flow-change", "release"],
      "risk": "File opening, persistence and semantic-authoring reachability."
    },
    {
      "id": "public-product",
      "pageId": "PUB-002",
      "route": "/product",
      "sourcePath": "apps/marketing/src/content/product.ts",
