{
  "schemaVersion": 2,
  "rule": "Use product-ontology.json for semantic entities and interface snapshot/live registries for tools, panels, views and surfaces. This file contains cross-domain controlled vocabulary.",
  "terms": [
    {
      "canonical": "ARQ",
      "definition": "Product name in public prose, product UI, support, documentation, and the wordmark",
      "avoid": ["Arc", "Arq in public-facing language"]
    },
    {
      "canonical": ".arq",
      "definition": "Native project file extension",
      "avoid": [".ARQ"]
    },
    {
      "canonical": "project",
      "definition": "Authoritative semantic architectural project",
      "avoid": ["document when project is meant"]
    },
    {
      "canonical": "project file",
      "definition": "Portable .arq file",
      "avoid": ["archive as the only user-facing name"]
    },
    {
      "canonical": "working copy",
      "definition": "Session-local editable representation",
      "avoid": []
    },
    {
      "canonical": "local journal",
      "definition": "Local ordered persistence/recovery record",
      "avoid": ["cloud save"]
    },
    {
      "canonical": "local save",
      "definition": "Persistence on the user's device",
      "avoid": ["sync"]
    },
    {
      "canonical": "sync",
      "definition": "Remote synchronisation",
      "avoid": ["save"]
    },
    {
      "canonical": "recovery",
      "definition": "Restoration after interruption",
      "avoid": ["autosave"]
    },
    {
      "canonical": "semantic model",
      "definition": "Authoritative semantic building/project objects and relationships",
      "avoid": ["render model as authority"]
    },
    {
      "canonical": "derived data",
      "definition": "Recomputable meshes/projections/indexes/thumbnails/caches",
      "avoid": ["project data"]
    },
    {
      "canonical": "view",
      "definition": "Semantic view definition",
      "avoid": ["tab"]
    },
    {
      "canonical": "view tab",
      "definition": "Open UI instance of a view",
      "avoid": ["view definition"]
    },
    {
      "canonical": "snapshot",
      "definition": "Recorded project state for system/history purposes",
      "avoid": ["revision when review semantics are intended"]
    },
    {
      "canonical": "revision",
      "definition": "Meaningful project state for review/comparison",
      "avoid": ["app version"]
    },
    {
      "canonical": "operation",
      "definition": "Typed mutation unit",
      "avoid": ["generic action when transaction semantics matter"]
    },
    {
      "canonical": "proposal",
      "definition": "Unapplied proposed operation group",
      "avoid": ["applied change"]
    },
    {
      "canonical": "validation error",
      "definition": "Blocking deterministic validation result",
      "avoid": ["warning"]
    },
    {
      "canonical": "warning",
      "definition": "Non-blocking detected condition",
      "avoid": ["error"]
    },
    {
      "canonical": "model health",
      "definition": "Grouped validation/diagnostic surface",
      "avoid": ["model quality score"]
    },
    {
      "canonical": "underlay",
      "definition": "Reference-only image/PDF",
      "avoid": ["imported model"]
    },
    {
      "canonical": "import",
      "definition": "External content entering ARQ through mapping/conversion",
      "avoid": []
    },
    {
      "canonical": "export",
      "definition": "External representation written from ARQ",
      "avoid": []
    },
    {
      "canonical": "import report",
      "definition": "Fidelity report for imported content",
      "avoid": []
    },
    {
      "canonical": "export report",
      "definition": "Scope/fidelity result for exported content",
      "avoid": []
    },
    {
      "canonical": "read-only",
      "definition": "Project/session can be inspected but not modified/saved as normal",
      "avoid": ["safe mode as sufficient user label"]
    },
    {
      "canonical": "sync conflict",
      "definition": "Remote/local operation/revision conflict requiring resolution",
      "avoid": ["merge error as generic copy"]
    },
    {
      "canonical": "Comment",
      "definition": "Review discussion",
      "avoid": ["Issue"]
    },
    {
      "canonical": "Issue",
      "definition": "Actionable tracked review problem",
      "avoid": ["Warning", "validation error"]
    },
    {
      "canonical": "Owner",
      "definition": "Permission role",
      "avoid": ["manager"]
    },
    {
      "canonical": "Administrator",
      "definition": "Permission role",
      "avoid": ["admin as visible label unless product chooses it"]
    },
    {
      "canonical": "Editor",
      "definition": "Permission role",
      "avoid": []
    },
    {
      "canonical": "Commenter",
      "definition": "Permission role",
      "avoid": []
    },
    {
      "canonical": "Viewer",
      "definition": "Permission role",
      "avoid": []
    },
    {
      "canonical": "Design",
      "definition": "Workspace mode",
      "avoid": []
    },
    {
      "canonical": "Document",
      "definition": "Workspace mode",
      "avoid": []
    },
    {
      "canonical": "Inspect",
      "definition": "Workspace mode",
      "avoid": []
    },
    {
      "canonical": "Review",
      "definition": "Workspace mode",
      "avoid": []
    },
    {
      "canonical": "Present",
      "definition": "Workspace mode",
      "avoid": []
    },
    {
      "canonical": "Project Browser",
      "definition": "Canonical panel name",
      "avoid": ["project sidebar"]
    },
    {
      "canonical": "Inspector",
      "definition": "Canonical panel name",
      "avoid": ["properties sidebar"]
    },
    {
      "canonical": "AI proposal",
      "definition": "Canonical future AI review surface/object",
      "avoid": ["AI architect", "copilot"]
    },
    {
      "canonical": "Preserved",
      "definition": "Import/export fidelity category",
      "avoid": []
    },
    {
      "canonical": "Converted",
      "definition": "Import/export fidelity category",
      "avoid": []
    },
    {
      "canonical": "Approximated",
      "definition": "Import/export fidelity category",
      "avoid": []
    },
    {
      "canonical": "Flattened",
      "definition": "Import/export fidelity category",
      "avoid": []
    },
    {
      "canonical": "Omitted",
      "definition": "Import/export fidelity category",
      "avoid": []
    },
    {
      "canonical": "Unsupported",
      "definition": "Import/export fidelity category",
      "avoid": []
    },
    {
      "canonical": "Retained as opaque data",
      "definition": "Import/export fidelity category",
      "avoid": []
    },
    {
      "canonical": "Failed",
      "definition": "Import/export fidelity category",
      "avoid": []
    },
    {
      "canonical": "hidden",
      "definition": "Not drawn in one view. The element is still in the project, still holds its relationships and still counts in every schedule.",
      "avoid": ["removed", "deleted", "excluded from the model"]
    },
    {
      "canonical": "clipped",
      "definition": "Cut by a section box in one view. The project is unchanged and quantities are unaffected.",
      "avoid": ["removed", "cut out of the project"]
    },
    {
      "canonical": "quarantined",
      "definition": "Imported content ARQ kept with its source payload and did not convert.",
      "avoid": ["skipped", "ignored", "dropped"]
    },
    {
      "canonical": "drawing unit",
      "definition": "The unit an imported drawing was drawn in. Unknown until the file declares it or a person chooses it.",
      "avoid": ["assumed unit", "default unit"]
    },
    {
      "canonical": "derived geometry",
      "definition": "Meshes and tessellations regenerated from the semantic model. Never a source of measurement.",
      "avoid": ["the model", "model geometry"]
    },
    {
      "canonical": "reversed",
      "definition": "Applied and then undone, leaving the project as it was. Distinct from refused, where nothing ran.",
      "avoid": ["rejected", "cancelled"]
    },
    {
      "canonical": "receipt",
      "definition": "A bounded, redacted record of one thing that happened, kept for diagnosis.",
      "avoid": ["log", "audit trail"]
    },
    {
      "canonical": "preserved evidence",
      "definition": "A local copy of the files involved in an incident, kept before any repair and sent nowhere.",
      "avoid": ["crash report", "uploaded diagnostics"]
    },
    {
      "canonical": "grant",
      "definition": "Permission a person gave, held separately from anything that asks for it.",
      "avoid": ["scope", "claimed permission"]
    },
    {
      "canonical": "release certificate",
      "definition": "The record naming the exact commit, the evidence that passed and who approved it. A release without one is not certified, whatever else it is.",
      "avoid": ["release notes", "changelog"]
    },
    {
      "canonical": "exact commit artifact",
      "definition": "A build bound to one commit, verified by digest rather than by branch name.",
      "avoid": ["latest build", "the build from main"]
    },
    {
      "canonical": "promotion",
      "definition": "Making an already-built, already-verified artifact live. Never a rebuild.",
      "avoid": ["deploy", "ship"]
    },
    {
      "canonical": "rollback rehearsal",
      "definition": "A rollback actually performed and observed before the release it protects.",
      "avoid": ["rollback plan"]
    }
  ],
  "registryPointers": {
    "semanticEntities": "02-canonical/product-ontology.json",
    "states": "02-canonical/state-language-map.json",
    "roles": "02-canonical/roles-permissions.json",
    "formats": "02-canonical/format-language-map.json",
    "aliases": "02-canonical/term-aliases.json",
    "interfaceSnapshot": "02-canonical/snapshots/interface-snapshot-2026-07-27.json"
  },
  "prohibitedUpgrades": [
    {
      "from": "hidden",
      "to": "removed",
      "reason": "Hiding is a drawing convention. Calling it removal tells a user their data is gone."
    },
    {
      "from": "clipped",
      "to": "deleted",
      "reason": "A section box changes one view. Nothing leaves the project."
    },
    {
      "from": "quarantined",
      "to": "imported",
      "reason": "Quarantined content was kept and not converted. Calling it imported claims a mapping that does not exist."
    },
    {
      "from": "quarantined",
      "to": "skipped",
      "reason": "Skipped implies the data is gone. It is in the project."
    },
    {
      "from": "reversed",
      "to": "applied",
      "reason": "A reversed proposal left the project unchanged."
    },
    {
      "from": "refused",
      "to": "failed",
      "reason": "A refusal is a decision ARQ made deliberately, not a fault."
    },
    {
      "from": "journal-saved",
      "to": "published",
      "reason": "A local journal append is not a portable file write."
    },
    {
      "from": "written",
      "to": "published",
      "reason": "Published requires an independent reader to have re-read and accepted the bytes."
    },
    {
      "from": "approved",
      "to": "applied",
      "reason": "Approval is a decision; applying is an event. They can differ."
    },
    {
      "from": "mesh measurement",
      "to": "dimension",
      "reason": "A length read from a tessellation is an approximation, not a measurement."
    },
    {
      "from": "built",
      "to": "released",
      "reason": "A build is an artifact. A release is a promotion someone approved."
    },
    {
      "from": "deployed to preview",
      "to": "live",
      "reason": "A preview deployment is not production."
    },
    {
      "from": "rollback plan",
      "to": "rollback rehearsed",
      "reason": "A plan nobody executed is not evidence that it works."
    }
  ]
}
