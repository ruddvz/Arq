  ],
  "registryPointers": {
    "semanticEntities": "02-canonical/product-ontology.json",
    "states": "02-canonical/state-language-map.json",
    "roles": "02-canonical/roles-permissions.json",
    "formats": "02-canonical/format-language-map.json",
