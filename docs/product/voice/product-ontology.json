  "distinctions": [
    {
      "a": "Project",
      "b": "project file",
      "rule": "Project is semantic data; project file is the portable .arq representation."
    },
    {
      "a": "View",
      "b": "view tab",
      "rule": "A semantic view definition may have more than one open view-tab instance."
    },
    {
      "a": "Snapshot",
      "b": "revision",
      "rule": "Do not use as synonyms unless the underlying history model explicitly equates them."
    },
    {
      "a": "Comment",
      "b": "Issue",
      "rule": "Comment is discussion; Issue is actionable tracked work/problem."
    },
    {
      "a": "Warning",
      "b": "validation error",
      "rule": "Warning is non-blocking; validation error blocks a commit/action."
    },
    {
      "a": "Underlay",
      "b": "imported model",
      "rule": "Underlay is reference-only and must not be described as authoritative semantic model data."
    },
    {
      "a": "Local save",
      "b": "sync",
      "rule": "Local persistence and remote synchronisation are separate state machines."
    },
    {
      "a": "Proposal",
      "b": "operation",
      "rule": "Proposal is unapplied intent; operation is a typed mutation unit."
    }
