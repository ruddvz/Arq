{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.invalid/spec/5.0/schema/exact-quantity.json",
  "title": "exact-quantity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coefficient",
    "scale",
    "unit"
  ],
  "properties": {
    "coefficient": {
      "type": "integer"
    },
    "scale": {
      "type": "integer",
      "minimum": -18,
      "maximum": 18
    },
    "unit": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]{0,63}$"
    },
    "tolerance_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
