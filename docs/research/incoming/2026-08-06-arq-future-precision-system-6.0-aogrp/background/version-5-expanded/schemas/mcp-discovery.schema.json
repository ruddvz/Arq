{
  "$id": "https://arq.example/schemas/demo/mcp-discovery-5.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "type": "object"
    },
    "protocolVersion": {
      "const": "2026-07-28"
    },
    "serverInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "tools": {
      "items": {
        "pattern": "^arq\\.",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "protocolVersion",
    "serverInfo",
    "capabilities",
    "tools"
  ],
  "title": "ARQ demo MCP discovery",
  "type": "object"
}
