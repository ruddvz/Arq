{
  "$id": "https://arq.example/schemas/demo/domain-pack-manifest-5.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coreRange": {
      "minLength": 1,
      "type": "string"
    },
    "namespace": {
      "pattern": "^[a-z0-9.-]+/[a-z0-9._/-]+$",
      "type": "string"
    },
    "operations": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schemas": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "namespace",
    "version",
    "coreRange",
    "schemas",
    "operations",
    "permissions"
  ],
  "type": "object"
}
