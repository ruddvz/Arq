{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.invalid/spec/5.0/schema/capability.json",
  "title": "capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "version",
    "requirement",
    "preservation"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+/[a-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requirement": {
      "enum": [
        "required",
        "optional"
      ]
    },
    "preservation": {
      "enum": [
        "interpreted",
        "opaque-byte-preserving",
        "discardable-derived"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
