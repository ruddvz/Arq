{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.invalid/spec/5.0/schema/operation-group.json",
  "title": "operation-group",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group_id",
    "project_id",
    "base_revision",
    "actor",
    "operations"
  ],
  "properties": {
    "group_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "object",
      "required": [
        "class",
        "id"
      ],
      "properties": {
        "class": {
          "enum": [
            "human",
            "ai",
            "importer",
            "migration",
            "repair",
            "merge",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "operation.schema.json"
      }
    },
    "provenance": {
      "type": "object"
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
