{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.invalid/spec/5.0/schema/operation.json",
  "title": "operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "type",
    "schema_version",
    "payload"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+/[a-z0-9._-]+$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {},
    "preconditions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      }
    },
    "read_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "write_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
