{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.invalid/spec/5.0/schema/revision.json",
  "title": "revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "project_id",
    "parents",
    "operation_group_id",
    "state_root"
  ],
  "properties": {
    "revision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "parents": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "operation_group_id": {
      "type": "string",
      "format": "uuid"
    },
    "state_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
