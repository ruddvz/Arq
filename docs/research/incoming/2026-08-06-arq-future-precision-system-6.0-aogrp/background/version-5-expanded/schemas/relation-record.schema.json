{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.invalid/spec/5.0/schema/relation-record.json",
  "title": "relation-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_id",
    "type_id",
    "source_id",
    "target_id",
    "role"
  ],
  "properties": {
    "relation_id": {
      "type": "string",
      "format": "uuid"
    },
    "type_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {}
  }
}
