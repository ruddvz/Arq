{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.invalid/spec/5.0/schema/component-record.json",
  "title": "component-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "schema_id",
    "schema_version",
    "payload"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {},
    "required_capability": {
      "type": "string"
    }
  }
}
