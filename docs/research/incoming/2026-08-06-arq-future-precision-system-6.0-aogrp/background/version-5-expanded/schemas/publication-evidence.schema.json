{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.invalid/spec/5.0/schema/publication-evidence.json",
  "title": "publication-evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publication_id",
    "project_id",
    "source_revision",
    "publisher_build",
    "phases",
    "fresh_reopen",
    "promoted"
  ],
  "properties": {
    "publication_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publisher_build": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "state"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "verified",
              "failed",
              "blocked",
              "skipped"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "fresh_reopen": {
      "type": "boolean"
    },
    "promoted": {
      "type": "boolean"
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
