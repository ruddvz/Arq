{
  "$id": "https://arq.example/schemas/demo/repair-report-5.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "records": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string"
          },
          "state": {
            "enum": [
              "recovered",
              "reconstructed",
              "omitted",
              "ambiguous",
              "unrecoverable"
            ]
          }
        },
        "required": [
          "kind",
          "state"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "sourceSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "state": {
      "enum": [
        "repaired",
        "partial",
        "failed"
      ]
    }
  },
  "required": [
    "sourceSha256",
    "candidateSha256",
    "state",
    "records"
  ],
  "type": "object"
}
