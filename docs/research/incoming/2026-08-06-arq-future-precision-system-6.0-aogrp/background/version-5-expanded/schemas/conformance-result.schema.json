{
  "$id": "https://arq.example/schemas/demo/conformance-result-5.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "implementation": {
      "minLength": 1,
      "type": "string"
    },
    "profile": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "enum": [
        "verified",
        "failed",
        "blocked"
      ]
    },
    "tests": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "blocked"
            ]
          }
        },
        "required": [
          "id",
          "state"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "profile",
    "implementation",
    "revision",
    "tests",
    "state"
  ],
  "type": "object"
}
