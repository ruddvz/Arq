{
  "$id": "https://arq.example/schemas/demo/signed-attestation-5.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "keyId": {
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "signature": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "algorithm",
    "keyId",
    "scope",
    "digest",
    "signature"
  ],
  "type": "object"
}
