{
  "$id": "https://arq.example/schemas/demo/migration-plan-5.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "sourceFormat": {
      "minimum": 1,
      "type": "integer"
    },
    "sourceRetention": {
      "const": true
    },
    "steps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "targetFormat": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "sourceFormat",
    "targetFormat",
    "steps",
    "sourceRetention"
  ],
  "type": "object"
}
