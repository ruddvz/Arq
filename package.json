{
  "name": "arq",
  "private": true,
  "version": "0.0.0",
  "description": "Arq monorepo - apps, packages, and workers. See docs/product/ARQ-COMPLETE-PRODUCT-ENGINEERING-BLUEPRINT-v1.0.md and docs/architecture/REPOSITORY-STRUCTURE.md.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:canvas2d": "node scripts/run-canvas-2d-benchmark.mjs",
    "benchmark:pixijs": "node scripts/run-pixijs-webgl-benchmark.mjs",
    "benchmark:canvaskit": "node scripts/run-canvaskit-benchmark.mjs",
    "benchmark:render-frame": "node scripts/run-render-frame-benchmark.mjs",
    "benchmark:pencil-input": "node scripts/run-pencil-pointer-capability-check.mjs",
    "benchmark:hover-sequence": "node scripts/run-hover-sequence-capability-check.mjs",
    "benchmark:arqfs-opfs": "node scripts/run-arqfs-opfs-capability-check.mjs",
    "benchmark:arqfs-writer-lock": "node scripts/run-arqfs-writer-lock-capability-check.mjs",
    "benchmark:arqfs-project-isolation": "node scripts/run-arqfs-project-isolation-capability-check.mjs",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "rust:fmt-check": "cargo fmt --manifest-path rust/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path rust/Cargo.toml --all-targets",
    "rust:build-wasm": "node scripts/build-arq-core-wasm.mjs",
    "rust:verify-wasm-parity": "node scripts/verify-arq-core-wasm-parity.mjs",
    "benchmark:arq-core-worker": "node scripts/run-arq-core-worker-capability-check.mjs",
    "check:dependency-licences": "node scripts/check-dependency-licences.mjs"
  },
  "devDependencies": {
    "canvaskit-wasm": "^0.41.1",
    "fast-check": "^3",
    "pixi.js": "^8.19.0",
    "playwright": "^1.61.1",
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2"
  }
}
