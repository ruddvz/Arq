# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Build artifacts
dist/
dist-build/
build/
coverage/
*.log
*.tsbuildinfo
.turbo/
.vite/

# Rust (ARQ-203) - target/ is Cargo's build cache; pkg/ is wasm-bindgen's
# regenerable output (scripts/build-arq-core-wasm.mjs rebuilds it from source)
rust/target/
**/pkg/

# Environment
.env
.env.*
!.env.example

# Generated by scripts/check-dependency-licences.mjs (ARQ-016) - regenerated every CI run.
/dependency-sbom.json

# Engineering OS 5.0 gate runtime artifacts (written by the engineering-gate
# workflow and by local runs of the classify/evidence tools).
.engineering-artifacts/
/engineering-classification.json
/engineering-selected-evidence.json
/engineering-evidence-decision.json
/.engineering-changed-files

# Generated mid-run by scripts/run-e2e-arq-open-capability-check.mjs, which
# bundles the real Worker entry with esbuild and removes it afterwards. Ignored
# so a run that dies in between does not leave an untracked build artifact
# looking like a source change.
workers/arqfs-worker/.e2e-open-bundle/

# Zeus 5 gate ledger. Per-task, per-workspace state: a recorded gate belongs to
# the fingerprint it was taken at, so it means nothing in another checkout and
# would only ever arrive stale. The continual harness store under
# .zeus/harness/ is deliberately NOT ignored: learned state is agent-proposed
# and human-committed, and a lesson nobody can review is the failure it exists
# to fix.
.zeus/gates/
.zeus/plans/
