{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arq.dev/schemas/zeus/compact-contract-5.json",
  "title": "Zeus 5 compact contract",
  "type": "object",
  "required": [
    "version",
    "intent",
    "interpretation",
    "mode",
    "risk",
    "tier",
    "deliveryStop",
    "blastRadius",
    "reversibility",
    "modules",
    "methods",
    "owner",
    "acceptance",
    "checks",
    "budget"
  ],
  "properties": {
    "version": {
      "const": "5.0.0"
    },
    "intent": {
      "type": "string",
      "maxLength": 320
    },
    "interpretation": {
      "type": "object",
      "description": "How the compiler read the request, shown to the operator before execution so a misread is caught in the first line rather than after the work.",
      "required": ["as", "not", "assumptions", "words"],
      "properties": {
        "as": {
          "type": "string"
        },
        "not": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "words": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "mode": {
      "enum": ["answer", "plan", "audit", "implement", "release", "incident"]
    },
    "risk": {
      "enum": ["low", "moderate", "high", "critical"]
    },
    "tier": {
      "enum": ["fast", "standard", "deep"]
    },
    "deliveryStop": {
      "enum": [
        "answer",
        "plan",
        "local-green",
        "pr-open",
        "ci-green",
        "merged",
        "production-verified"
      ]
    },
    "blastRadius": {
      "enum": ["local", "package", "product", "persistent", "public", "production"]
    },
    "reversibility": {
      "enum": ["reversible", "compensable", "irreversible"]
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modulePaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "methods": {
      "type": "object",
      "required": ["primary", "supporting", "formatting", "scopes"],
      "properties": {
        "primary": {
          "type": "string"
        },
        "supporting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formatting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "owner": {
      "type": "string"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewAgents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Subagents under .claude/agents/ that must run an independent pass at this tier."
    },
    "scope": {
      "type": "array"
    },
    "nonGoals": {
      "type": "array"
    },
    "acceptance": {
      "type": "array"
    },
    "checks": {
      "type": "array"
    },
    "budget": {
      "type": "object",
      "required": ["modules", "sources", "contextChars", "repairRounds", "supportingMethods"]
    },
    "cachePolicy": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
