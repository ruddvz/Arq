{
  "version": "5.0.0",
  "project": "Arq",
  "roles": [
    {
      "id": "executor",
      "accountable": true,
      "capabilities": ["scope", "task-graph", "authority", "delivery-state"]
    },
    {
      "id": "product-architecture",
      "capabilities": ["workflow", "ADR", "package-boundaries", "scope"]
    },
    {
      "id": "geometry-bim",
      "capabilities": [
        "units",
        "tolerances",
        "topology",
        "property-tests",
        "semantic entities",
        "operations",
        "undo",
        "serialization"
      ]
    },
    {
      "id": "editor-interaction",
      "capabilities": ["commands", "selection", "snapping", "input", "focus"]
    },
    {
      "id": "rendering-performance",
      "capabilities": ["2D", "3D", "benchmarks", "frame-budget"]
    },
    {
      "id": "arqfs-recovery",
      "capabilities": ["SQLite", "OPFS", "migration", "sync", "recovery"]
    },
    {
      "id": "ui-visual",
      "capabilities": ["design-system", "responsive", "pixel-regression"]
    },
    {
      "id": "accessibility",
      "capabilities": ["keyboard", "screen-reader", "touch", "contrast"]
    },
    {
      "id": "security",
      "capabilities": ["threat-model", "authorization", "secrets", "dependencies"]
    },
    {
      "id": "ai-arqscript",
      "capabilities": ["typed operations", "validation", "diff", "assumptions"]
    },
    {
      "id": "interoperability",
      "capabilities": ["IFC", "DXF", "DWG", "PDF", "provenance", "unit-mapping"]
    },
    {
      "id": "incident-commander",
      "capabilities": ["stabilisation", "rollback", "recovery", "communication"]
    },
    {
      "id": "qa-release",
      "capabilities": ["tests", "evidence", "release-gate", "smoke"]
    },
    {
      "id": "delivery-reliability",
      "capabilities": ["PR", "CI", "logs", "merge", "deploy", "incident"]
    }
  ],
  "moduleOwners": {
    "architecture": "product-architecture",
    "geometry": "geometry-bim",
    "editor-input": "editor-interaction",
    "arqfs": "arqfs-recovery",
    "rendering": "rendering-performance",
    "ui-visual": "ui-visual",
    "accessibility": "accessibility",
    "security": "security",
    "github-cicd": "delivery-reliability",
    "release-production": "delivery-reliability",
    "ai": "ai-arqscript",
    "interoperability": "interoperability",
    "incident": "incident-commander"
  },
  "modeOwners": {
    "release": "delivery-reliability",
    "incident": "delivery-reliability"
  },
  "defaultOwner": "executor",
  "reviewRoles": {
    "always": "qa-release",
    "persistentOrWider": "security"
  }
}
