{
  "version": "5.0.0",
  "project": "Arq",
  "mode": "adaptive-fast",
  "nodeMinimum": 18,
  "budgets": {
    "fast": {
      "modules": 1,
      "sources": 4,
      "contextChars": 4000,
      "contractChars": 900,
      "repairRounds": 2,
      "supportingMethods": 2
    },
    "standard": {
      "modules": 4,
      "sources": 10,
      "contextChars": 12000,
      "contractChars": 1800,
      "repairRounds": 3,
      "supportingMethods": 4
    },
    "deep": {
      "modules": 8,
      "sources": 24,
      "contextChars": 32000,
      "contractChars": 3200,
      "repairRounds": 5,
      "supportingMethods": 8
    }
  },
  "harness": {
    "store": ".zeus/harness/state.json",
    "promptCharBudget": 600,
    "maxActiveEntries": 40,
    "maxTitleChars": 90,
    "maxContentChars": 600,
    "maxEvidenceChars": 300,
    "rollbackWindow": 5
  },
  "cache": {
    "directory": ".zeus/cache",
    "indexTtlSeconds": 86400,
    "checkTtlSeconds": 300,
    "lockStaleSeconds": 60,
    "criticalEvidenceCache": false
  },
  "index": {
    "maxFileBytes": 1000000,
    "sampleChars": 4096,
    "maxKeywords": 30,
    "exclude": [
      ".git",
      "node_modules",
      "dist",
      "build",
      "coverage",
      ".next",
      "target",
      "vendor",
      ".zeus/cache",
      ".zeus/runs"
    ]
  },
  "context": {
    "sourceCaps": {
      "fast": 3,
      "standard": 6,
      "deep": 12
    },
    "snippetChars": 1200,
    "maxReturnedHeadings": 4,
    "coldPathHints": [
      "all-contents.md",
      "implementation_ledger",
      "implementation-ledger",
      "/archive/",
      "/archives/",
      "/historical/",
      "/history/",
      "changelog"
    ]
  },
  "timeoutsMs": {
    "focused": 120000,
    "package": 300000,
    "build": 600000,
    "ciPoll": 900000
  },
  "gates": {
    "store": ".zeus/gates/current.json",
    "repositoryGates": ["format:check", "lint", "typecheck", "test", "build"],
    "reviewRequiredAtRisk": ["high", "critical"],
    "reviewQuorumWhenUnmatched": {
      "low": 1,
      "moderate": 1,
      "high": 2,
      "critical": 2
    }
  },
  "status": ["green", "partial", "blocked", "failed", "rolled_back"],
  "evidenceStates": [
    "verified",
    "partially-verified",
    "inferred",
    "assumed",
    "blocked",
    "not-inspected",
    "failed"
  ],
  "greenEvidenceStates": ["verified"],
  "sourceAuthority": [
    "current working tree and repository head",
    "executed checks, tests, schemas, migrations and measured benchmarks",
    "accepted ADRs and the Engineering OS classification for the diff under review",
    "current product and architecture specifications",
    "planning packages, prompt packs and historical documents"
  ],
  "authorityNotes": {
    "recencyIsNotAuthority": "A newer document does not outrank an older one by date alone.",
    "specificationIsNotProof": "A specification states intent. Only executed evidence states behaviour.",
    "conflictsAreNotResolvedSilently": "Record the conflict and keep the weaker claim until an owner resolves it."
  },
  "gate": {
    "authority": "engineering-os-5",
    "note": "Zeus classifies, routes and produces local evidence. It may raise a lane or add impacts. It may never lower a lane, mark missing evidence as passed, or stand in for the engineering-gate workflow."
  },
  "plan": {
    "store": ".zeus/plans/current.json",
    "maxItems": 60,
    "maxTitleChars": 120,
    "maxAcceptanceChars": 400
  }
}
